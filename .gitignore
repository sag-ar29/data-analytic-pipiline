# ==============================================================================
# Security & Sensitive Data Ignore Rules
# ==============================================================================

# --- Environment Variables & Local Secret Configurations ---
.env
.env.*
*.env
!.env.example
!.env.template
secrets.json
secrets.yaml
secrets.yml
local.settings.json
config.local.json

# --- Private Keys, Certificates & Keystores ---
*.pem
*.key
*.p12
*.pfx
*.pkcs12
*.crt
*.cer
*.der
*.jks
*.keystore

# --- SSH Keys & Remote Access ---
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_dsa
id_ecdsa
*.ppk

# --- API Keys, Auth Tokens & Service Accounts ---
credentials.json
client_secret*.json
service-account*.json
service_account*.json
firebase-adminsdk*.json
*token*.json
auth_token*
*.token
*.jwt

# --- Cloud Provider & Container Registry Credentials ---
.aws/
.azure/
.gcp/
.dockercfg
.docker/config.json

# --- Package Manager & CLI Auth Credentials ---
.netrc
.npmrc
.pypirc

# --- Local Databases & Sensitive Dumps ---
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz
*.bak

# --- Logs & Shell Histories (May contain passwords or tokens) ---
*.log
.bash_history
.zsh_history
.python_history

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/


